# Copy this file to `.env` and adjust. `.env` is gitignored — never commit secrets.

# UK Carbon Intensity API (free, no key required).
CARBON_API_BASE_URL=https://api.carbonintensity.org.uk

# Local DuckDB warehouse file.
DUCKDB_PATH=data/carbon.duckdb

# HTTP request timeout, in seconds.
REQUEST_TIMEOUT_SECONDS=10
